{
  // Servidor de salas para jugar con varios celus. Se publica con: npx wrangler deploy (desde esta carpeta).
  "name": "sobremesa-salas",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }]
}
